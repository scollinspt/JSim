#!/bin/bash

# create nonJava JNI .h headers via javah 

. jsbuild.path

build_header() {
	CLASS=$1
	if [ -x "$JSIMSDK/bin/javah" ]
	then
		"$JSIMSDK/bin/javah" -jni "$CLASS"
	else
		SOURCE=`echo "$CLASS" | tr . /`.java
		"$JSIMSDK/bin/javac" -h "$PWD" -d "$JSIMSRC" "$JSIMSRC/$SOURCE"
	fi
}

cd $JSIMSRC/JSim/nonJava

rm -f */JSim_nml_*.h

cd math
build_header JSim.nml.math.NatMath
cd ..

cd ode1
build_header JSim.nml.ode1.ODE1Solver
cd radau
build_header JSim.nml.ode1.ODE1SolverRadau
cd ../dopri5
build_header JSim.nml.ode1.ODE1SolverDopri5
cd ../cvode
build_header JSim.nml.ode1.ODE1SolverCVode
cd ../..

cd pde1
build_header JSim.nml.pde1.PDE1Solver
build_header JSim.nml.pde1.PDE1SolverToms731
cd ..

cd opt
build_header JSim.nml.opt.Optimizer
cd simplex
build_header JSim.nml.opt.Simplex
cd ../ggopt/
build_header JSim.nml.opt.GGopt
cd ../nl2sol/
build_header JSim.nml.opt.NL2sol
cd ../..


